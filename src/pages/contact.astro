---
import Base from '../layouts/Base.astro';
import L from '../components/L.astro';
import SectionTitle from '../components/SectionTitle.astro';
import { load, makeUI } from '../lib/content.js';

const site = load('site');
const u = makeUI();
const tel = (p) => `tel:${p.replace(/\s/g, '')}`;
---
<Base path="contact/">
  <section class="block">
    <div class="container">
      <SectionTitle title={u('contact_title')} />
      <div class="grid g2">
        <div class="card">
          <h3>📍 <L v={u('address_label')} /></h3>
          <p><L v={site.address} /></p>
          <p style="margin-top:12px"><a class="btn btn-primary" href={site.map_link} target="_blank" rel="noopener"><L v={u('open_map')} /></a></p>
          <h3 style="margin-top:22px">📞 <L v={u('phone_label')} /></h3>
          {site.phones.map((p) => (
            <p><a href={tel(p)}><strong>{p}</strong></a></p>
          ))}
          <p style="margin-top:12px;display:flex;gap:10px;flex-wrap:wrap">
            <a class="btn btn-gold" href={tel(site.phones[0])}><L v={u('call_btn')} /></a>
            {site.whatsapp && <a class="btn btn-green" href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener"><L v={u('whatsapp_btn')} /></a>}
          </p>
          <h3 style="margin-top:22px">🕰 <L v={u('timings_title')} /></h3>
          <ul class="timings">
            {site.timings.map((x) => <li><span><L v={x.label} /></span><strong><L v={x.time} /></strong></li>)}
          </ul>
        </div>
        <div>
          {site.map_embed
            ? <iframe class="map" src={site.map_embed} loading="lazy" title="Map"></iframe>
            : <div class="empty">📍 <a href={site.map_link} target="_blank" rel="noopener"><L v={u('open_map')} /></a></div>}
        </div>
      </div>
    </div>
  </section>
</Base>
