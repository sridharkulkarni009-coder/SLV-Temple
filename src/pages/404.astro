---
import Base from '../layouts/Base.astro';
import L from '../components/L.astro';
---
<Base path="404">
  <section class="block" style="text-align:center;padding:110px 0">
    <div class="container">
      <div class="om-big">ॐ</div>
      <h2 class="nf-title"><L v={{ en: 'Page not found', kn: 'ಪುಟ ಸಿಗಲಿಲ್ಲ' }} /></h2>
      <p style="margin:10px 0 26px"><L v={{ en: 'The page you are looking for does not exist.', kn: 'ನೀವು ಹುಡುಕುತ್ತಿರುವ ಪುಟ ಲಭ್ಯವಿಲ್ಲ.' }} /></p>
      <a class="btn btn-gold" href="/"><L v={{ en: 'Back to Home', kn: 'ಮುಖಪುಟಕ್ಕೆ ಹಿಂತಿರುಗಿ' }} /></a>
    </div>
  </section>
</Base>
